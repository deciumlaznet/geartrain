# Use whichever pnpm the host provides (Replit's publish build cannot download
# the version pinned in package.json and aborts).
manage-package-manager-versions=false
# Install only what the app needs to run by default. Replit's publish build
# runs a plain `pnpm install`, and its package firewall blocks some test-only
# packages. For development and CI use: pnpm install --prod=false
production=true
