# Runs the Geartrain demo (fake clients, stand-in Xero/HMRC/Companies House).
# Replit provides pnpm; installs are production-only because Replit's package
# firewall blocks some test-only packages.
modules = ["nodejs-22"]
run = "pnpm install --frozen-lockfile --prod && DEMO_DATE=${DEMO_DATE:-2026-11-03} pnpm --filter @geartrain/web start"

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
build = ["sh", "-c", "pnpm install --frozen-lockfile --prod"]
run = ["sh", "-c", "DEMO_DATE=${DEMO_DATE:-2026-11-03} pnpm --filter @geartrain/web start"]
deploymentTarget = "cloudrun"
