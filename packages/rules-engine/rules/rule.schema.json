{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geartrain.example/schemas/rule.schema.json",
  "title": "Geartrain rule file",
  "description": "Shape of the Geartrain rule file from v0.3. Follows the rule engine build specification plus Engineering's amendments 1-8. Money in integer pence, dates ISO (Europe/London), months YYYY-MM, enums camelCase.",
  "type": "object",
  "required": [
    "name",
    "version",
    "asOf",
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "asOf": {
      "$ref": "#/$defs/date"
    },
    "status": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "mode": {
      "enum": [
        "agent",
        "signoff",
        "interplay",
        "human"
      ]
    },
    "fieldPath": {
      "description": "Namespaced path: fact.*, series.*, derived.*, payload.* (payload only inside event rules).",
      "type": "string",
      "pattern": "^(fact|series|derived|payload)\\.[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)*$"
    },
    "test": {
      "type": "object",
      "required": [
        "field",
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/fieldPath"
        },
        "op": {
          "enum": [
            "gte",
            "gt",
            "lt",
            "lte",
            "eq",
            "in",
            "has",
            "sizeAtLeast"
          ]
        },
        "value": {}
      }
    },
    "condition": {
      "oneOf": [
        {
          "const": "always"
        },
        {
          "$ref": "#/$defs/test"
        },
        {
          "type": "object",
          "required": [
            "all"
          ],
          "additionalProperties": false,
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "any"
          ],
          "additionalProperties": false,
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "additionalProperties": false,
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          }
        }
      ]
    },
    "offset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "months": {
          "type": "integer"
        },
        "days": {
          "type": "integer"
        }
      }
    },
    "deadline": {
      "type": "object",
      "required": [
        "anchor",
        "offset"
      ],
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "enum": [
            "triggerDate",
            "periodStart",
            "periodEnd",
            "financialYearEnd",
            "incorporationDate",
            "taxYearEnd",
            "taxMonthEnd",
            "payday",
            "snapshotDate",
            "fixed"
          ]
        },
        "fixed": {
          "type": "string",
          "pattern": "^\\d{2}-\\d{2}$",
          "description": "MM-DD, only with anchor fixed"
        },
        "payloadField": {
          "$ref": "#/$defs/fieldPath",
          "description": "Event rules: payload date to anchor on"
        },
        "offset": {
          "$ref": "#/$defs/offset"
        },
        "adjust": {
          "enum": [
            "none",
            "previousWorkingDay",
            "nextWorkingDay"
          ],
          "default": "none"
        }
      }
    },
    "obligation": {
      "type": "object",
      "required": [
        "id",
        "title",
        "recurrence",
        "deadline"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string"
        },
        "recurrence": {
          "type": "object",
          "required": [
            "every"
          ],
          "additionalProperties": false,
          "properties": {
            "every": {
              "enum": [
                "once",
                "monthly",
                "taxMonth",
                "quarterly",
                "annual",
                "accountingPeriod",
                "financialYear"
              ]
            },
            "interval": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "description": "Repeat every N units: {every: monthly, interval: 6} is six-monthly; {every: annual, interval: 2|3|4} is every two, three or four years"
            }
          }
        },
        "deadline": {
          "$ref": "#/$defs/deadline"
        },
        "remindDaysBefore": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "mode": {
          "$ref": "#/$defs/mode",
          "description": "Overrides the rule's mode"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "penalty": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          }
        }
      }
    },
    "warn": {
      "type": "object",
      "required": [
        "when"
      ],
      "additionalProperties": false,
      "properties": {
        "when": {
          "$ref": "#/$defs/condition"
        },
        "project": {
          "type": "object",
          "required": [
            "series",
            "threshold"
          ],
          "additionalProperties": false,
          "properties": {
            "series": {
              "$ref": "#/$defs/fieldPath"
            },
            "threshold": {
              "type": "integer",
              "description": "In the series' unit: pence for money, people for headcount"
            }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$"
        },
        "where": {
          "$ref": "#/$defs/condition"
        }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "version",
        "pack",
        "factor",
        "title",
        "module",
        "phase",
        "effectiveFrom",
        "obligations",
        "verified",
        "status",
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "pack": {
          "type": "string",
          "description": "gb-core, scotland, wales, construction, ..."
        },
        "factor": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "phase": {
          "type": "integer",
          "minimum": 1
        },
        "trigger": {
          "enum": [
            "threshold",
            "event"
          ],
          "default": "threshold"
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "event": {
          "$ref": "#/$defs/event"
        },
        "warn": {
          "$ref": "#/$defs/warn"
        },
        "exitAfter": {
          "type": "integer",
          "minimum": 0,
          "description": "Months the condition must stay false before exited fires"
        },
        "headcountBasis": {
          "type": "string"
        },
        "sizeBasis": {
          "enum": [
            "entity",
            "group",
            "connected"
          ]
        },
        "obligations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/obligation"
          }
        },
        "onExit": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/obligation"
          }
        },
        "effectiveFrom": {
          "$ref": "#/$defs/date"
        },
        "effectiveTo": {
          "oneOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "legalRef": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "verified": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "status": {
          "enum": [
            "consulted",
            "announced",
            "enacted",
            "inForce",
            "repealed"
          ],
          "description": "Announced, consulted and enacted rules create notices only; inForce rules create obligations"
        },
        "penalty": {
          "type": "object",
          "required": [
            "text",
            "basis"
          ],
          "additionalProperties": false,
          "properties": {
            "amountPence": {
              "type": "integer",
              "minimum": 0
            },
            "text": {
              "type": "string"
            },
            "basis": {
              "enum": [
                "fixed",
                "estimate",
                "unlimited"
              ]
            }
          }
        },
        "reviewBy": {
          "$ref": "#/$defs/date"
        },
        "mode": {
          "$ref": "#/$defs/mode",
          "description": "Default for obligations that do not set their own mode"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "trigger": {
                "const": "event"
              }
            },
            "required": [
              "trigger"
            ]
          },
          "then": {
            "required": [
              "event"
            ],
            "not": {
              "required": [
                "when"
              ]
            }
          },
          "else": {
            "required": [
              "when",
              "onExit"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "verified": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "sourceUrl"
            ],
            "properties": {
              "sourceUrl": {
                "pattern": "^https://(www\\.)?(legislation\\.gov\\.uk|gov\\.uk|[a-z0-9.-]+\\.gov\\.uk|[a-z0-9.-]+\\.org\\.uk)/"
              }
            }
          }
        }
      ]
    }
  }
}